# ─── Database ────────────────────────────────────────────────────
DB_NAME=helpdesk
DB_USER=helpdesk
# Todas las variables marcadas "OBLIGATORIO" deben reemplazarse por un
# valor propio: la app rechaza arrancar si detecta estos valores de
# ejemplo o si quedan vacías (ver backend/src/config/validateEnv.js).
DB_PASSWORD=OBLIGATORIO_definir_contraseña_segura

# ─── Redis ───────────────────────────────────────────────────────
REDIS_PASSWORD=OBLIGATORIO_definir_contraseña_segura

# ─── JWT ─────────────────────────────────────────────────────────
# Generar con: openssl rand -base64 64
JWT_SECRET=OBLIGATORIO_generar_con_openssl_rand_-base64_64
JWT_REFRESH_SECRET=OBLIGATORIO_generar_otro_valor_distinto
JWT_EXPIRES_IN=24h

# ─── MinIO (File Storage) ────────────────────────────────────────
MINIO_USER=helpdesk_minio
MINIO_PASSWORD=OBLIGATORIO_definir_contraseña_segura
MINIO_BUCKET=helpdesk-files

# ─── URLs ────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost
# Dejar VITE_API_URL y VITE_WS_URL vacías (recomendado): el frontend usa
# el mismo origen desde el que se cargó la página. Esto es necesario para
# el modo multi-subdominio (ver APP_BASE_DOMAIN) y evita tener que
# reconstruir el frontend cada vez que cambia la IP/dominio público.
VITE_API_URL=
VITE_WS_URL=

# Dominio base para el modo "una empresa por subdominio", ej:
#   APP_BASE_DOMAIN=ticket.ucp.edu.ar
# Cada empresa entra por <slug>.ticket.ucp.edu.ar (el slug es el campo
# "slug" de la empresa) y ve su propio nombre/logo en el login. Requiere
# un registro DNS wildcard (*.ticket.ucp.edu.ar) y un certificado que lo
# cubra (Let's Encrypt wildcard vía DNS-01, o un cert por subdominio).
# Vacío = deshabilitado, un único login compartido como hasta ahora.
APP_BASE_DOMAIN=

# ─── WhatsApp Business API (Meta Cloud) ──────────────────────────
# Verify Token: cadena propia que vos elegís, usada para validar el
# webhook GET de Meta.
WA_WEBHOOK_VERIFY_TOKEN=definir_token_propio_aleatorio
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
# App Secret de la app de Meta (Configuración básica de la app) — se usa
# para verificar la firma HMAC de los webhooks entrantes (X-Hub-Signature-256).
WA_APP_SECRET=
# UUID de la empresa (tabla companies) a la que pertenecen los tickets
# creados por WhatsApp. Esta instalación soporta un único número de
# WhatsApp Business, por lo que ese número queda asociado a una sola empresa.
WA_DEFAULT_COMPANY_ID=

# ─── Cifrado de secretos en base (contraseñas IMAP/SMTP) ─────────
# Generar con: openssl rand -hex 32
ENCRYPTION_KEY=OBLIGATORIO_generar_con_openssl_rand_-hex_32

# ─── SSO (opcional) ────────────────────────────────────────────────
# Google Workspace: Google Cloud Console > APIs & Services > Credentials >
# OAuth client ID (tipo "Web application"), agregar el dominio del
# frontend a "Authorized JavaScript origins". Dejar vacío para no mostrar
# el botón de Google en el login.
GOOGLE_CLIENT_ID=

# Microsoft/Azure AD: Azure Portal > Microsoft Entra ID > App registrations
# > New registration. Habilitar "ID tokens" en Authentication > Implicit
# grant, y agregar la URL del frontend + "/login" como Redirect URI
# (tipo SPA) -- el login vuelve a esa misma página a completar el flujo.
# Dejar vacío para no mostrar el botón.
AZURE_CLIENT_ID=
AZURE_TENANT_ID=

# ─── Superadmin inicial ──────────────────────────────────────────
SUPER_ADMIN_EMAIL=admin@helpdesk.local
SUPER_ADMIN_PASSWORD=OBLIGATORIO_definir_contraseña_segura
SUPER_ADMIN_NAME=Super Admin
